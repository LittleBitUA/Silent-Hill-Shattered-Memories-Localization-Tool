# ============================================================================
# Game ISOs / disc images — never commit. User supplies their own legal dumps.
# ============================================================================
*.iso
*.rvz
*.wbfs
*.imageDiff
*.ARC
*.arc

# ============================================================================
# Source extraction directories (large, regenerated by user from their dumps)
# ============================================================================
/wii_extract/
/psp_orig_extract/
/psp_rus_extract/
/psp_extract_work/
/_wii_orig_probe/
/rus/

# Translation file backups
*.bak

# ============================================================================
# Translation work — users generate their own from their own legal disc dumps
# via tool/init_translation_template.py. Never commit translation text.
# ============================================================================
TEXT_TRANSLATION/
TEXT_TRANSLATION*/

# ============================================================================
# Build output directories (regenerated from sources by build_ua_*.py)
# ============================================================================
/UA/
/UA_wii/
/UA_psp/

# ============================================================================
# Working artifact directory — large PS2/Wii .arc entries extracted as .bin,
# plus Metallist reference data. pack_platform_strings.py needs unpacked/data/
# but only 2 specific files (1315_*.bin, 1316_*.bin); the rest are local.
# ============================================================================
/unpacked/data/
/unpacked/rus_data/
/unpacked/rus_*.arc

# unpacked/glyphs*/ IS committed — those are the user's PNG glyph edits.

# ============================================================================
# GUI (Electron + Vite) — node_modules and build outputs
# ============================================================================
/gui/node_modules/
/gui/dist/
/gui/dist-electron/
/gui/release/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================================
# Editor / OS junk
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
